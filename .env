# Backend server
BACKEND_PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
VITE_API_URL=http://localhost:5000/api

# Trust proxy: number of reverse-proxy hops, or the IP of your proxy/LB/CDN.
TRUST_PROXY=1

# JWT signing secret - REQUIRED. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=25833a71582b5f58f59b388d12f355a1fe92b361a0b4dddf4d97dc2bbaccbdedc484759193caf7e0428e436d4f6ba3dc
JWT_EXPIRES_IN=1h
# Set to "false" to auth via Authorization Bearer header only
USE_HTTPONLY_COOKIE=true

# Rate limiting (requests per window)
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AUTH=20
RATE_LIMIT_CONTACT=10
JSON_BODY_LIMIT=100kb

# SQLite database location (relative to project root database/ by default)
# DB_DIR=./database
# DB_PATH=./database/app.sqlite

# SMTP settings - use your email provider's SMTP service.
# IMPORTANT: if the previous SMTP_PASS was ever committed to source control,
# REVOKE/RESET it at the provider and generate a fresh app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=unknown012045@gmail.com
# Replace with a freshly generated app password (never commit a real secret).
SMTP_PASS=REPLACE_WITH_FRESH_APP_PASSWORD
SMTP_FROM=unknown012045@gmail.com

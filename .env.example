# Backend server
BACKEND_PORT=5000
NODE_ENV=production
FRONTEND_ORIGIN=https://your-frontend-domain.com
VITE_API_URL=https://your-api-domain.com/api

# Trust proxy: number of reverse-proxy hops, or the IP of your proxy/LB/CDN.
TRUST_PROXY=1

# JWT signing secret - REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=1h
USE_HTTPONLY_COOKIE=true

# Rate limiting (requests per window)
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AUTH=20
RATE_LIMIT_CONTACT=10
JSON_BODY_LIMIT=100kb

# SQLite database location (persistent volume in production)
# DB_DIR=./database
# DB_PATH=./database/app.sqlite

# SMTP settings - use your email provider's SMTP service.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=REPLACE_WITH_FRESH_APP_PASSWORD
SMTP_FROM=your-email@example.com
